#!name=中国联通去广告
#!desc=去除首页弹窗、开屏、Banner、信息流、服务提醒等广告（基于 iphone_c@12.01 抓包）
#!author=stoneluka49
#!icon=https://img.client.10010.com/favicon.ico

[Script]
response if ${url} ~= /^https:\/\/(m\.client\.10010\.com\/(mobileService\/activity\/homePopUpActivityNew\.htm|mobileService\/customer\/accountListData\.htm|(clientIndex|mobileserviceNine)\/homefusion\/fuInter|clientIndex\/api\/v1\/index\/(queryIndexWaterfall|queryOMO|queryIndexExclusiveOffers)|mobileserviceNine\/api\/v1\/homeService\/getServiceHomeMarketingBits|clientIndex\/v1\/api\/(serviceReminder|query517Active)|getDataFromService\?.*methodType=searchScroll)|(card|m)\.10010\.com\/mall-access\/(homePage\/v25\/(topTab\/activityShow|query\/smartHome|query\/unicomCulture|topTerminalShow|topBanner)|query\/waterfallFlow))/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/Unicom/unicom_ad.js") with tag="联通去广告", requires_body=true

[MITM]
hostname = m.client.10010.com, card.10010.com, m.10010.com
