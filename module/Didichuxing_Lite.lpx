#!name = 滴滴出行精简版
#!desc = 去广告 + 精简界面：底栏仅保留「首页」「我的」；首页金刚区仅保留 顺风车、代驾、青桔骑行、专车、更多服务；「我的」页仅保留个人信息、订单/钱包/客服/设置、优惠券。
#!author = 基于「怎么肥事」QX 规则 + 抓包重构
#!date = 2026-10-13
#!category = 去广告

[Rule]
DOMAIN,gwp.xiaojukeji.com,REJECT
IP-CIDR,123.207.209.39/32,REJECT-DROP,no-resolve
IP-CIDR,123.207.209.60/32,REJECT-DROP,no-resolve

[Rewrite]
# ---------- 广告 / 营销 / 弹窗 ----------
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getMulti\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/xpget/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getInsActivityV2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds/i then reject_dict(200)
request if ${url} ~= /^https:\/\/freight\.xiaojukeji\.com\/gateway/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/slow/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/ota\/na\/yuantu\/infoList/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/watson\/v1\/bubble\/getBubble/i then reject_dict(200)
# > 滴滴青桔
request if ${url} ~= /^https?:\/\/pt-starimg\.didistatic\.com\/static\/starimg\/node\/.*.(jpg|png|gif)/i then reject(200)
request if ${url} ~= /^https?:\/\/omgup[0-9]{1}\.xiaojukeji\.com\/api/i then reject(200)
# 横幅广告
request if ${url} ~= /^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/conf\?ns=daijia-front&name=/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/daijia\.kuaidadi\.com\/gateway\?api=prado\.cms\.delivery\.batch&apiVe/i then reject_dict(200)
# ---------- 首页：底栏只留 首页/我的；金刚区只留 顺风车/代驾/青桔骑行/专车/更多服务 ----------
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core/i then response.json.jq(".data |= ((if .order_cards.nav_list_card.data then .order_cards.nav_list_card.data |= map(select(.nav_id == \"carmate\" or .nav_id == \"driverservice\" or .nav_id == \"bike\" or .nav_id == \"special_ride\" or .nav_id == \"nav_more_v2\" or .nav_id == \"nav_more_v3\")) else . end) | (if .order_cards then .order_cards |= with_entries(select(.key == \"nav_list_card\" or .key == \"inprogress_order_card\")) else . end) | (if .order_cards_list then .order_cards_list |= map(select(. == \"nav_list_card\" or . == \"inprogress_order_card\")) else . end) | (if .disorder_cards.bottom_nav_list.data then .disorder_cards.bottom_nav_list.data |= map(select(.id == \"home_page\" or .id == \"v6x_home\" or .id == \"user_center\")) else . end) | (if .disorder_cards.top_nav_list.data.top_nav_info then .disorder_cards.top_nav_list.data.top_nav_info |= map(select(.name != \"旅行\" and .name != \"车主\")) else . end))")

# ---------- 我的：只留 个人信息 / 订单·钱包·客服·设置 / 优惠券 ----------
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me/i then response.json.jq(".data.cards |= (map(select(.tag == \"profile\" or .tag == \"general\" or .tag == \"wallet\")) | map(if .tag == \"wallet\" then ((if .items then .items |= map(select(.title == \"优惠券\")) else . end) | (if .bottom_items then .bottom_items |= map(select(.title == \"省钱套餐\" or .title == \"出行里程\")) else . end)) else . end))")

response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v[5-9]\/usercenter\/layout/i then response.json.jq(".data.layout.order |= map(select(. == \"center_base_info_card\" or . == \"center_order_related_card\" or . == \"center_wallet_finance_card\")) | (.data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == \"优惠卡券\"))) | del(.data.instances.center_marketing_card, .data.instances.center_member_card, .data.instances.center_tool_card, .data.instances.center_widget_list)")

# ---------- 叫车页 / 行程中 / 海外 的营销模块 ----------
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v1\/other\/pGetSceneList/i then response.json.jq(".data.scene_list |= map(select(.text != \"优惠商城\")) | .data.show_data |= map(.scene_ids |= map(select(. != \"scene_coupon_mall\")))")
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/oversea\/layout/i then response.json.jq("del(.data.instances.oversea_main_banner)")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout/i then response.json.jq("del(.data.instances[\"xp-card-01\"])")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/passenger-center\/v2\/other\/pInTripLayout/i then response.json.jq("del(.data.order_components[8].data) | .data.order_components |= map(select(.name != \"passenger_common_casper\"))")

# ---------- 钱包 / 资产 / 零钱 ----------
response if ${url} ~= /^https:\/\/mapi\.xiaojukeji\.com\/passenger-wallet\/api\/v[\d.]+\/wallet\/homepage/i then response.json.jq(".data.cardList |= (map(if .mcode == \"index_assets_v6\" then .detailData |= (del(.myCreditLimit) | .discountList |= .[:3] | del(.noticeList)) else . end) | map(select(.mcode == \"index_assets_v6\")))")
response if ${url} ~= /^https:\/\/manhattan\.webapp\.xiaojukeji\.com\/zootopia\/api\/my-assets\/get-assets-data/i then response.json.jq("del(.data.myQuotaModularRes, .data.assetsData.myQuotaModularRes, .data.banner, .data.assetsData.banner, .data.myGuaranteeModularRes, .data.assetsData.myGuaranteeModularRes)")
response if ${url} ~= /^https:\/\/manhattan\.webapp\.xiaojukeji\.com\/zootopia\/api\/my-assets\/module-is-show/i then response.json.jq(".data = []")
response if ${url} ~= /^https:\/\/ddpay\.xiaojukeji\.com\/ddpay\/api\/manhattan-small-change\/get-all-config/i then response.json.jq(".data.result = []")
response if ${url} ~= /^https:\/\/ddpay\.xiaojukeji\.com\/ddpay\/api\/manhattan-small-change\/get-apollo-config/i then response.json.jq(".data.result.hideList = []")

[MITM]
hostname = pt-starimg.didistatic.com,omgup*.xiaojukeji.com,common.diditaxi.com.cn, conf.diditaxi.com.cn, api.udache.com, res.xiaojukeji.com, ct.xiaojukeji.com, freight.xiaojukeji.com, mapi.xiaojukeji.com, manhattan.webapp.xiaojukeji.com, ddpay.xiaojukeji.com
