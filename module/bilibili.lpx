#!name = 哔哩哔哩 𝕏
#!desc = 过滤哔哩哔哩广告、扫码登录原生签名修复、1080P高码率画质解锁、Bilibili国际版-分区修复(针对国际版BILIBILI 3.20.1 版本）
#!openUrl = https://apps.apple.com/app/id736536022
#!author = TomCatXue + ddgksf2013 + bm7 + kokoryh + stoneluka49


[Rewrite]

#～BiliBili_哔哩哔哩_屏蔽IP请求
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/ip/i then reject(404)

#～BiliBili_哔哩哔哩_小卡片广告
request if ${url} ~= /^https:\/\/api.bilibili.com\/pgc\/season\/player\/cards/i then reject_dict(200)

#～BiliBili_哔哩哔哩_可能的一些推广(beta)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/season\/app\/related\/recommend\?/i then reject_dict(200)

# 移除搜索框默认词
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/i then response.body.mock("text", "AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=", 200, true)

#～BiliBili_哔哩哔哩_Defaultword
request if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/search\/defaultwords/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/Default/i then reject(404)

# 拦截 B 站 WBI 热搜/搜索广场 API(针对国际版BILIBILI 3.20.1 版本）
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square(?:\?.*)?$/i then response.json.jq("del(.data[2], .data[0])")

#～BiliBili_哔哩哔哩_去除动态中的话题
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr/i then reject_dict(200)

# 非会员开启会员专属清晰度 (本地UI显示)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then response.json.jq(".data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end")

# 为上述 gRPC Mock 接口与原生分区接口补充 grpc-status=0 (防止新版客户端因缺少状态头触发错误断流)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.header.add("grpc-status", "0")
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.show\.v1\.(Mixture\/(RegionIndex|RegionList)|Rank\/RankRegionList)$/i then response.header.add("grpc-status", "0")

# 腾讯云海外 COS (upos-sz-mirrorcosov / mirror*ov) -> 国内腾讯云 COS
request if ${url} ~= /^http:\/\/upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com\/upgcxcode\/(.*)$/i as urlMatch then redirect(302, "http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/${urlMatch.1}")
# Akamai 海外 -> 国内腾讯云 COS
request if ${url} ~= /^http:\/\/upos-hz-mirrorakam\.akamaized\.net\/upgcxcode\/(.*)$/i as urlMatch then redirect(302, "http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/${urlMatch.1}")


[Script]
# 自动捕获当前用户 access_key (供扫码登录签名生成使用)
request if ${url} ~= /^https?:\/\/(?:app|api)\.bilibili\.com\/x\/(?:v2\/account\/mine|v2\/account\/myinfo|member\/app\/nickfree|resource\/show\/tab)/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili_qrcode.js") with tag="[哔哩哔哩]凭证捕获"

# 扫码登录原生签名生成与授权修复 (自动计算真实签名授权服务端入库)
request if ${url} ~= /^https:\/\/passport\.bilibili\.com\/x\/passport-login\/web\/qrcode\/(check|confirm|scene)/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili_qrcode.js") with tag="[哔哩哔哩]扫码登录修复", timeout=30, requires_body=true

# 移除搜索结果广告
response if ${url} ~= /^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili.protobuf.js") with tag="移除搜索结果广告", requires_body=true, binary_body_mode=true

#Bilibili国际版-分区修复(针对国际版BILIBILI 3.20.1 版本）
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/channel\/region\/list\?/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili_region_fix.js") with tag="BiliRegionFix", timeout=30, requires_body=true

#Bilibili国际版-去除流量卡/会员推广
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(com|net))\/bilibili\.app\.view\.v1\.View\/TFInfo$/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili_tfinfo_block.js") with tag="BiliTFInfo", timeout=30, requires_body=true, binary_body_mode=true

#Bilibili国际版-去除云视听小电视徽章
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.(com|net))\/bilibili\.community\.service\.dm\.v1\.DM\/DmView$/i then script("https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/BiliBili/bilibili_dmview_tvbadge.js") with tag="BiliDmViewTV", timeout=30, requires_body=true, binary_body_mode=true

[MITM]
hostname = grpc.biliapi.net,app.bilibili.com, api.bilibili.com, passport.bilibili.com, app.biliapi.net, app.biliapi.com
