request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^+&]+)(?:\+|%20)yh.+/i as urlMatch then redirect(302, "https://greasyfork.org/zh-CN/scripts?q=${urlMatch.1}")
# gi - Google 图片
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gi(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^+&]+)(?:\+|%20)gi.+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
# ios - 苹果应用搜索
