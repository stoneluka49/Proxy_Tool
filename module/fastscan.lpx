#!name=快捷搜索
#!desc=指令快捷搜索,适用于LOON
#!author=bai1zi


[Rewrite]
# 兜底：必须放在最前面！Loon 会依次执行所有命中的规则，后执行的 302 覆盖先执行的，
# 所以兜底放最前，后面具体规则命中时才能覆盖它
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?q=${urlMatch.1}")

# gm - Google 图片
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gm(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
# gh - GitHub
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gh(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://github.com/search?q=${urlMatch.1}")
# sof - Stack Overflow
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=sof(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://stackoverflow.com/search?q=${urlMatch.1}")
# se - Stack Exchange
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=se(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://stackexchange.com/search?q=${urlMatch.1}")
# wa - WolframAlpha
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wa(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.wolframalpha.com/input/?i=${urlMatch.1}")
# wiki - Wikipedia
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wiki(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://wikipedia.org/wiki/${urlMatch.1}")
# wk - 中文 Wikipedia
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wk(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
# mg - Magi
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=mg(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://magi.com/search?q=${urlMatch.1}")
# tf - Google 搜索 TestFlight
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tf(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?as_q=${urlMatch.1}&as_sitesearch=testflight.apple.com")
# yd - 有道
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=yd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://dict.youdao.com/search?q=${urlMatch.1}")
# trc - Google 翻译 → 中文
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=trc(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=zh-CN&text=${urlMatch.1}")
# tre - Google 翻译 → 英文
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tre(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=en&text=${urlMatch.1}")
# trj - Google 翻译 → 日文
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=trj(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=ja&text=${urlMatch.1}")
# db - 豆瓣
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=db(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://m.douban.com/search/?query=${urlMatch.1}")
# zh - 知乎
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=zh(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.zhihu.com/search?type=content&q=${urlMatch.1}")
# wb - 微博
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wb(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://s.weibo.com/weibo/${urlMatch.1}")
# wx - 微信
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wx(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://weixin.sogou.com/weixinwap?query=${urlMatch.1}")
# rd - Reddit
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=rd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.reddit.com/search?q=${urlMatch.1}")
# tw - X / Twitter
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tw(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://x.com/search?q=${urlMatch.1}")
# ssp - 少数派
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=ssp(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://sspai.com/search/post/${urlMatch.1}")
# csdn - CSDN
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=csdn(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://so.csdn.net/so/search/s.do?q=${urlMatch.1}&t=&u=")
# zdm - 什么值得买
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=zdm(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://search.m.smzdm.com/?v=b&s=${urlMatch.1}")
# amz - 亚马逊
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=amz(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.amazon.cn/gp/aw/s/?k=${urlMatch.1}")
# jd - 京东
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=jd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://so.m.jd.com/ware/search.action?keyword=${urlMatch.1}")
# tb - 淘宝
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tb(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://s.m.taobao.com/h5?q=${urlMatch.1}")
# tm - 天猫
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tm(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://s.m.tmall.com/m/search.htm?q=${urlMatch.1}")
# ac - AcFun
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=ac(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.acfun.cn/search?keyword=${urlMatch.1}")
# bli - 哔哩哔哩
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bli(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://m.bilibili.com/search?keyword=${urlMatch.1}")
