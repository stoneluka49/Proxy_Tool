request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=ytb(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.youtube.com/results?search_query=${urlMatch.1}")
# ph - PornHub
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=ph(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://cn.pornhub.com/video/search?search=${urlMatch.1}")
# af xxx - AcFun
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^+&]+)(?:\+|%20)af.+/i as urlMatch then redirect(302, "https://www.acfun.cn/search?keyword=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=af(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.acfun.cn/search?keyword=${urlMatch.1}")
# ys xxx - 茶杯狐
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^+&]+)(?:\+|%20)ys.+/i as urlMatch then redirect(302, "https://cupfox.app/search?key=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=ys(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://cupfox.app/search?key=${urlMatch.1}")
# gd - Google Drive
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?q=%22Google+Drive%22+${urlMatch.1}")
# tgd - Telegram / gdurl
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tgd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://t.me/s/gdurl?q=${urlMatch.1}")
# zgd - zhao.pp.ua
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=zgd(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://zhao.pp.ua/?q=${urlMatch.1}")
# bi - 必应
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bi(?:\+|%20)([^&]+).+/i as urlMatch then redirect(302, "https://cn.bing.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^+&]+)(?:\+|%20)bi.+/i as urlMatch then redirect(302, "https://cn.bing.com/search?q=${urlMatch.1}")
# bd - 百度
