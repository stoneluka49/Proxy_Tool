
#!name=MissAV 去播放弹窗
#!desc=屏蔽点击播放时 window.open 弹出的广告页


[Rewrite]
# 兜底:就算弹窗逻辑没被改掉,广告跳转页也直接拦截
^https:\/\/missav\.ws\/pop\? - reject-200

[Script]
# 在视频页 <head> 后注入:让 window.open 失效,并伪装成"窗口已关闭"
http-response ^https:\/\/missav\.ws\/(?!(?:pop|build|cdn-cgi|api|img|fonts|js)(?:\/|\?|$))[^?]*$ script-path=https://raw.githubusercontent.com/stoneluka49/Proxy_Tool/refs/heads/main/Script%20/MISSAV/response.js, requires-body=true, tag=MissAV去弹窗

[MITM]
hostname = missav.ws
