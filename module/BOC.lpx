
#!name=中国银行去广告
#!desc=中国银行去广告取自其他大佬


[Rewrite]
response if ${url} ~= /^https?:\/\/cdn1.mbs.boc.cn\/ubas-mgateway-static\/images\/advertType\/.+.jpg/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cdn1.mbs.boc.cn\/ubas-mgateway-static\/images\/\/theme\//i then response.body.mock("text", "{}", 200)

[MITM]
hostname = *.mbs.boc.cn
